# FutureWings Environment Configuration Example
# Copy to .env and customize for your environment.

# ASP.NET Core Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Demo Mode: Enables judge demo accounts and simulated checkout. Rejected in Production.
FUTUREWINGS_DEMO_MODE=true

# Staff Seeding: Set to true if judge requires Admin / Agent pre-seeded accounts.
FUTUREWINGS_SEED_STAFF=false

# SQL Server Database SA Password
MSSQL_SA_PASSWORD=YourStrong@Pass123!

# JWT Secret Key (minimum 32 bytes required for HMAC-SHA256)
JWT_SECRET=a-random-super-secret-key-that-is-at-least-thirty-two-chars-long!

# CORS Allowed Frontend Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document Storage Directory (Mounted to persistent volume in Docker)
DocumentStorage__Path=/app/App_Data/documents

# Stripe Configuration (Required in Production; demo keys supported in Development only)
# Stripe__SecretKey=sk_live_...
# Stripe__PublishableKey=pk_live_...
# Stripe__WebhookSecret=whsec_...
# Stripe__Prices__Pro=price_...
# Stripe__Prices__Premium=price_...
