# FutureWings ClientApp Environment Variables
# Copy this file to .env.local and adjust values for your environment.

# API base URL (defaults to /api which is proxied by Vite in development)
# VITE_API_URL=/api

# MediaPipe WASM runtime base URL (defaults to jsDelivr CDN)
# VITE_MEDIAPIPE_WASM_BASE=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm

# MediaPipe face detector model URL (defaults to Google Storage)
# VITE_MEDIAPIPE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_detector/blaze_face_short_range/float16/1/blaze_face_short_range.tflite
